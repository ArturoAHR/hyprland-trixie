# hyprland-trixie defaults.
# Override any of these in ~/.config/hyprland-trixie/config.env (`hyprland-trixie config` creates it),
# or for one command as an environment variable: MODULES="hyprlock" hyprland-trixie build 0.56.2
# Everything here is a preference. The install layout itself is fixed:
#   $OPT_ROOT/<app>/<version>/   one folder per build
#   $OPT_ROOT/<app>/current      relative link to the version your session starts
#   $BIN_DIR/<program>           absolute link through current

# --- Where things go
OPT_ROOT="$HOME/.local/opt"
BIN_DIR="$HOME/.local/bin"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hyprland-trixie"
IMAGE=hyprland-trixie

# --- Optional modules built into every Hyprland version (list them: hyprland-trixie modules)
MODULES="hyprland-guiutils"

# --- Build
JOBS=                 # parallel compile jobs; empty: one per CPU, at most one per 2 GB of free RAM
BUILD_TYPE=Release    # Release, RelWithDebInfo (bigger, readable crash backtraces) or Debug

# --- Session
AQ_DRM_DEVICES=       # GPU order on multi-GPU machines, display GPU first: /dev/dri/card1:/dev/dri/card0
                      # empty lets Hyprland choose, which is usually right

# --- Starter config, written once, only when ~/.config/hypr/hyprland.lua doesn't exist yet
TERMINAL=kitty        # Hyprland's own default
LAUNCHER=             # empty: hyprlauncher if built, else hyprland-run if built, else Hyprland's default
QT_PLATFORM_THEME=    # QT_QPA_PLATFORMTHEME for Qt apps: kde, qt6ct, ...; empty leaves Qt's default
POLKIT_AGENT=         # command that answers admin password prompts; empty: hyprpolkitagent if built
                      # e.g. /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1
